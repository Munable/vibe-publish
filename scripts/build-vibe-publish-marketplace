#!/usr/bin/env ruby
# frozen_string_literal: true

require "digest"
require "fileutils"
require "json"
require "optparse"
require "rbconfig"
require "uri"

ROOT = File.expand_path("..", __dir__)
DEFAULT_SOURCE_PLUGIN = File.join(ROOT, "codex-plugins", "vibe-publish")
SOURCE_PLUGIN =
  [DEFAULT_SOURCE_PLUGIN, File.join(ROOT, "plugins", "vibe-publish")]
    .find { |path| Dir.exist?(path) } || DEFAULT_SOURCE_PLUGIN
MARKETPLACE_NAME = "committown"
PLUGIN_NAME = "vibe-publish"
PUBLIC_SOURCE_PATHS = [
  ".agents/skills/vibe-publish",
  "local-tool",
  "scripts/build-vibe-publish-plugin",
  "scripts/build-vibe-publish-marketplace",
  "scripts/accept-vibe-publish-plugin-install",
  "scripts/accept-vibe-publish-online-auth",
  "scripts/test/vibe_publish_marketplace_builder_test.rb",
].freeze

options = {}
OptionParser.new do |parser|
  parser.banner = "Usage: scripts/build-vibe-publish-marketplace --output DIR --forum-url URL --source-url HTTPS_GIT_URL"
  parser.on("--output DIR", "New controlled marketplace root to create") do |value|
    options[:output] = value
  end
  parser.on("--forum-url URL", "Exact forum base URL for this distribution") do |value|
    options[:forum_url] = value
  end
  parser.on("--source-url HTTPS_GIT_URL", "Public HTTPS Git marketplace URL") do |value|
    options[:source_url] = value
  end
end.parse!

abort "--output is required" if options[:output].to_s.empty?
abort "--forum-url is required" if options[:forum_url].to_s.empty?
abort "--source-url is required" if options[:source_url].to_s.empty?

def validated_forum_url(value)
  uri = URI.parse(value)
  abort "--forum-url must be an absolute HTTP(S) URL" unless %w[http https].include?(uri.scheme) && !uri.hostname.to_s.empty?
  abort "--forum-url must not contain credentials" if uri.userinfo
  abort "--forum-url must not contain a query or fragment" if uri.query || uri.fragment

  hostname = uri.hostname.downcase
  example_host =
    %w[example.com example.net example.org forum.example.com].include?(hostname) ||
      hostname.end_with?(".example", ".invalid", ".test")
  abort "--forum-url must be the real forum URL, not an example or reserved host" if example_host

  loopback = %w[localhost 127.0.0.1 ::1].include?(hostname)
  if uri.scheme == "http" && !loopback
    abort "Remote --forum-url values must use HTTPS; HTTP is allowed only for loopback testing"
  end

  uri.path = uri.path.sub(%r{/+\z}, "")
  uri.path = "" if uri.path == "/"
  uri.to_s
rescue URI::InvalidURIError => e
  abort "Invalid --forum-url: #{e.message}"
end

def validated_source_url(value)
  uri = URI.parse(value)
  abort "--source-url must be an absolute HTTPS URL" unless uri.scheme == "https" && !uri.hostname.to_s.empty?
  abort "--source-url must not contain credentials" if uri.userinfo
  abort "--source-url must not contain a query or fragment" if uri.query || uri.fragment

  hostname = uri.hostname.downcase
  reserved_host =
    %w[localhost 127.0.0.1 ::1 example.com example.net example.org].include?(hostname) ||
      hostname.end_with?(".example", ".invalid", ".test")
  abort "--source-url must be a real public Git URL, not a loopback or reserved host" if reserved_host

  path_parts = uri.path.split("/").reject(&:empty?)
  abort "--source-url must identify a Git repository path" if path_parts.length < 2

  uri.path = uri.path.sub(%r{/+\z}, "")
  uri.to_s
rescue URI::InvalidURIError => e
  abort "Invalid --source-url: #{e.message}"
end

def copy_public_source_snapshot!(root, output, paths)
  files = []
  paths.each do |relative|
    source = File.join(root, relative)
    abort "Public source path is missing: #{relative}" unless File.exist?(source)

    entries =
      if File.directory?(source)
        Dir.glob(File.join(source, "**", "*"), File::FNM_DOTMATCH).reject do |path|
          %w[. ..].include?(File.basename(path))
        end
      else
        [source]
      end
    entries.each do |path|
      snapshot_relative = path.delete_prefix("#{root}/")
      abort "Public source snapshot contains a symlink: #{snapshot_relative}" if File.lstat(path).symlink?
      next unless File.file?(path)

      destination = File.join(output, snapshot_relative)
      FileUtils.mkdir_p(File.dirname(destination))
      FileUtils.cp(path, destination, preserve: true)
      files << snapshot_relative
    end
  end
  files.uniq.sort
end

def inventory(root, relative_paths)
  relative_paths.sort.map do |relative|
    path = File.join(root, relative)
    {
      "path" => relative,
      "bytes" => File.size(path),
      "mode" => format("%03o", File.stat(path).mode & 0o777),
      "sha256" => Digest::SHA256.file(path).hexdigest,
    }
  end
end

def tree_sha256(files)
  input = files.map { |file| [file["sha256"], file["mode"], file["bytes"], file["path"]].join(" ") }.join("\n") + "\n"
  Digest::SHA256.hexdigest(input)
end

output = File.expand_path(options.fetch(:output))
forum_url = validated_forum_url(options.fetch(:forum_url))
source_url = validated_source_url(options.fetch(:source_url))
abort "Refusing to overwrite existing output: #{output}" if File.exist?(output)
abort "Generated plugin is missing: #{SOURCE_PLUGIN}" unless Dir.exist?(SOURCE_PLUGIN)
plugin_check = File.join(ROOT, "scripts", "build-vibe-publish-plugin")
abort "Generated plugin failed its exact-file check" unless
  system(RbConfig.ruby, plugin_check, "--check", out: File::NULL, err: File::NULL)

plugin_manifest_path = File.join(SOURCE_PLUGIN, ".codex-plugin", "plugin.json")
plugin_manifest = JSON.parse(File.read(plugin_manifest_path, encoding: "UTF-8"))
abort "Unexpected plugin name" unless plugin_manifest["name"] == PLUGIN_NAME
abort "Plugin must declare Apache-2.0" unless plugin_manifest["license"] == "Apache-2.0"
version = plugin_manifest.fetch("version").to_s
abort "Plugin version is missing" if version.empty?
license_source = File.join(SOURCE_PLUGIN, "LICENSE")
abort "Packaged Apache-2.0 LICENSE is missing" unless File.file?(license_source)

marketplace = {
  "name" => MARKETPLACE_NAME,
  "interface" => { "displayName" => "CommitTown" },
  "plugins" => [
    {
      "name" => PLUGIN_NAME,
      "source" => { "source" => "local", "path" => "./plugins/#{PLUGIN_NAME}" },
      "policy" => { "installation" => "AVAILABLE", "authentication" => "ON_USE" },
      "category" => "Productivity",
    },
  ],
}

FileUtils.mkdir_p(File.join(output, ".agents", "plugins"))
FileUtils.mkdir_p(File.join(output, "plugins"))
FileUtils.cp_r(SOURCE_PLUGIN, File.join(output, "plugins", PLUGIN_NAME), preserve: true)
source_snapshot_paths = copy_public_source_snapshot!(ROOT, output, PUBLIC_SOURCE_PATHS)
FileUtils.cp(license_source, File.join(output, "LICENSE"), preserve: true)
FileUtils.cp(
  File.join(SOURCE_PLUGIN, "CONTRIBUTING.md"),
  File.join(output, "CONTRIBUTING.md"),
  preserve: true,
)
FileUtils.cp(
  File.join(SOURCE_PLUGIN, "SECURITY.md"),
  File.join(output, "SECURITY.md"),
  preserve: true,
)

marketplace_path = File.join(output, ".agents", "plugins", "marketplace.json")
File.write(marketplace_path, JSON.pretty_generate(marketplace) + "\n")

readme_path = File.join(output, "README.md")
File.write(
  readme_path,
  <<~MARKDOWN,
    # Vibe Publish Marketplace

    论坛 / Forum: **#{forum_url}**
    Marketplace source: **#{source_url}**

    ## 一句话安装 / Install with one prompt

    把下面整句话复制给 Codex；它会自己运行命令、打开窄权限授权页并完成连接检查：

    ```text
    请帮我安装并连接 CommitTown 官方发帖 Skill：先核对公开来源 #{source_url}，运行 `codex plugin marketplace add #{source_url} --json`；如果结果中的 `alreadyAdded` 为 `true`，就运行 `codex plugin marketplace upgrade committown --json`，然后运行 `codex plugin add vibe-publish@committown --json`，不要创建重复配置；读取安装结果里的 `installedPath`，只运行该目录下的 `tool/bin/vibe-forum`，先为 #{forum_url} 执行 `doctor --site #{forum_url}`，只有报告 `credentials: missing` 或 `reauthorization_required` 时才执行 `auth --site #{forum_url}`，打开它输出的授权网址并只批准 `vibe-governance:publish`，已有健康凭据就跳过授权；最后执行 `doctor --site #{forum_url} --online` 和 `site-info --site #{forum_url}`，不要让我粘贴密码或密钥，也不要发布任何内容，完成后只告诉我安装与连接结果。
    ```

    Copy the whole sentence below into Codex. It will run the commands, open the narrow authorization page, and verify the connection:

    ```text
    Install and connect the official CommitTown posting Skill for me: first verify the public source #{source_url} and run `codex plugin marketplace add #{source_url} --json`; if `alreadyAdded` is `true` in the result, run `codex plugin marketplace upgrade committown --json`, then run `codex plugin add vibe-publish@committown --json` without creating duplicate configuration; read `installedPath` from the install result and run only `tool/bin/vibe-forum` inside that directory, first run `doctor --site #{forum_url}` for #{forum_url}, and only if it reports `credentials: missing` or `reauthorization_required`, run `auth --site #{forum_url}`, open its authorization URL, and approve only `vibe-governance:publish`; skip authorization when credentials are healthy; finally run `doctor --site #{forum_url} --online` and `site-info --site #{forum_url}`; never ask me to paste a password or key, do not publish anything, and report only the installation and connection result when finished.
    ```

    ## 从 0.5 升级 / Upgrade from 0.5

    旧安装也只需要把下面一句话交给 Codex；它会保留独立的论坛凭据并完成迁移检查：

    ```text
    请把这台设备上的 CommitTown 旧版安装迁移到公开版本：先确认 `vibe-private` 与 `committown` 是不同的 Marketplace 身份，依次运行 `codex plugin remove vibe-publish@vibe-private --json`、`codex plugin marketplace remove vibe-private --json`、`codex plugin marketplace add #{source_url} --json` 和 `codex plugin add vibe-publish@committown --json`，不要删除或修改独立的 `~/.config/vibe-forum` 凭据；读取新安装结果里的 `installedPath`，只运行其中的 `tool/bin/vibe-forum`，为 #{forum_url} 完成 `doctor --site #{forum_url} --online` 与 `site-info --site #{forum_url}`，校验失败就停止且不要发布任何内容，最后只告诉我迁移结果。
    ```

    Existing 0.5 installations also use one Codex prompt. It preserves the separate forum credential and verifies the migration:

    ```text
    Migrate this device from the old CommitTown installation to the public release: first confirm that `vibe-private` and `committown` are distinct Marketplace identities, then run `codex plugin remove vibe-publish@vibe-private --json`, `codex plugin marketplace remove vibe-private --json`, `codex plugin marketplace add #{source_url} --json`, and `codex plugin add vibe-publish@committown --json` without deleting or editing the separate `~/.config/vibe-forum` credential; read `installedPath` from the new install result and run only its `tool/bin/vibe-forum`, complete `doctor --site #{forum_url} --online` and `site-info --site #{forum_url}` for #{forum_url}, stop on any verification failure without publishing anything, and report only the migration result.
    ```

    ## 前置条件 / Requirements

    - Codex CLI with Plugin support.
    - Ruby 2.6 or newer available as `ruby` on `PATH`.
    - macOS is the currently accepted test platform. Linux still requires device acceptance; Windows is not supported by the 0.6 release.
    - A forum account that can approve the exact `vibe-governance:publish` User API Key scope.
    - The 0.6 release stores the complete narrow credential at `~/.config/vibe-forum/credentials.json` with exact owner-only (`0600`) permissions on macOS and Linux/POSIX. Keychain is retired; an explicit Keychain choice fails before authorization starts.

    ## 普通用户示例 / Ordinary-user examples

    以下都是发给 Codex 的请求，不是终端命令。每一次写入都会先显示完整预览并等待本人确认。
    These are prompts for Codex, not terminal commands. Every write shows a complete preview and waits for the user's confirmation.

    **1. 发布主题 / Publish a topic**

    ```text
    $vibe-publish:vibe-publish 把我下面的项目记录整理成中英双语主题，原文是中文。先给我完整预览，不要直接发布：……
    ```

    **2. 回复主题 / Reply to a topic**

    请打开真实主题页面并使用论坛原生 **Reply / 回复**。旧版 `reply` manifest 只可由
    0.6.1 在本地读取，作为 0.6.0 的审计记录；CLI 和服务端都不会再用它发布或编辑回复。

    Open the real topic page and use the forum's native **Reply** action. Version 0.6.1 can read a
    legacy `reply` manifest locally as 0.6.0 audit evidence, but neither the CLI nor the server will
    use it to publish or edit a reply.

    **3. 编辑自己的主题首帖 / Edit my own topic's first post**

    ```text
    $vibe-publish:vibe-publish 编辑我自己的主题首帖 post_id <post-id>，把版本号改成 0.2，并同步更新中英文。先读取当前版本并展示差异，不要覆盖其他人的修改。
    ```

    **4. 撤销发布权限 / Revoke publishing access**

    ```text
    $vibe-publish:vibe-publish 撤销这台设备的论坛发布权限，并确认服务端撤销成功。
    ```

    撤销 key **不会删除任何帖子**；它只撤销这台设备保存的窄权限凭据。服务端确认后，本地凭据才会删除。
    Revoking the key **does not delete any post**; it only removes this device's narrow publishing access. The local credential is deleted only after server confirmation.

    更多用户说明见 `plugins/vibe-publish/README.md`。
    See `plugins/vibe-publish/README.md` for the full user guide.

    ## 源码、许可证与证明边界 / Source, license, and proof boundaries

    - 本仓库以 Apache-2.0 发布；根目录 `LICENSE` 与 Plugin 内 `LICENSE` 内容一致。运行时代码是可读的 Ruby 源码，没有封闭二进制载荷。
    - `.agents/skills/vibe-publish`、`local-tool`、构建/验收脚本和测试组成可复核源码快照；`vibe-publish-release.json` 记录源码树、Plugin 树和许可证 SHA-256。
    - 本地构建器只验证本地字节和声明的 `#{source_url}`。它不抓取远程仓库，不能证明远程 tag、GitHub Release、分支保护、外部安装或论坛生产状态；这些字段在发布清单中明确为 `false`，必须在发布后另行验收。
    - `vibe-governance:publish` 是窄 User API scope，不会绕过论坛账号、主题、作者归属、内容限制或服务端审核规则。新主题的内部发布目的地由 Plugin 自动解析，不向用户提供选择。
    - 完整凭据保存在本机 owner-only `0600` 文件，而不是 Keychain。相同系统账号下能读取该文件的进程仍可能取得凭据；不要把它提交、上传或放入模型上下文。

    - This repository is Apache-2.0 licensed. Its root `LICENSE` matches the Plugin copy, and the runtime is readable Ruby source with no closed binary payload.
    - `.agents/skills/vibe-publish`, `local-tool`, build/acceptance scripts, and tests form the auditable source snapshot. `vibe-publish-release.json` hashes the source tree, Plugin tree, and license.
    - The local builder verifies local bytes and the declared `#{source_url}` only. It does not fetch the remote repository and cannot prove its tag, GitHub Release, branch protection, external installation, or production forum state. The release manifest records those checks as `false` until separate post-publication acceptance.
    - The `vibe-governance:publish` User API scope does not bypass normal account, topic, author-ownership, content-limit, or server-policy enforcement. The Plugin resolves the new-topic destination internally and offers no user choice.
    - The complete credential is an owner-only `0600` local file, not a Keychain item. Another process running as the same OS user may still read it; never commit, upload, or place it in model context.
  MARKDOWN
)

packaged_root = File.join(output, "plugins", PLUGIN_NAME)
plugin_relative_paths =
  Dir.glob(File.join(packaged_root, "**", "*"), File::FNM_DOTMATCH)
    .select { |path| File.file?(path) }
    .sort
    .map { |path| path.delete_prefix("#{packaged_root}/") }
files = inventory(packaged_root, plugin_relative_paths)
source_files = inventory(output, source_snapshot_paths)
license_path = File.join(output, "LICENSE")
contributing_path = File.join(output, "CONTRIBUTING.md")
security_path = File.join(output, "SECURITY.md")
release = {
  "schema" => "vibe-codex-plugin-release/v2",
  "forum_url" => forum_url,
  "source_url" => source_url,
  "source" => {
    "url" => source_url,
    "declared_ref" => "v#{version}",
    "remote_repository_fetched" => false,
    "remote_ref_verified" => false,
  },
  "license" => {
    "spdx_id" => "Apache-2.0",
    "path" => "LICENSE",
    "sha256" => Digest::SHA256.file(license_path).hexdigest,
  },
  "onboarding" => {
    "path" => "README.md",
    "sha256" => Digest::SHA256.file(readme_path).hexdigest,
  },
  "contributing" => {
    "path" => "CONTRIBUTING.md",
    "sha256" => Digest::SHA256.file(contributing_path).hexdigest,
  },
  "security" => {
    "path" => "SECURITY.md",
    "sha256" => Digest::SHA256.file(security_path).hexdigest,
  },
  "marketplace" => {
    "name" => MARKETPLACE_NAME,
    "path" => ".agents/plugins/marketplace.json",
    "sha256" => Digest::SHA256.file(marketplace_path).hexdigest,
  },
  "plugin" => {
    "id" => "#{PLUGIN_NAME}@#{MARKETPLACE_NAME}",
    "name" => PLUGIN_NAME,
    "version" => version,
    "source_path" => "plugins/#{PLUGIN_NAME}",
    "manifest_sha256" => Digest::SHA256.file(File.join(packaged_root, ".codex-plugin", "plugin.json")).hexdigest,
    "tree_sha256" => tree_sha256(files),
    "files" => files,
  },
  "source_snapshot" => {
    "tree_sha256" => tree_sha256(source_files),
    "files" => source_files,
  },
  "verification" => {
    "local_source_snapshot_hashed" => true,
    "local_plugin_tree_hashed" => true,
    "remote_repository_fetched" => false,
    "remote_ref_verified" => false,
    "external_install_verified" => false,
    "forum_reachability_verified" => false,
    "production_write_verified" => false,
  },
}

release_path = File.join(output, "vibe-publish-release.json")
File.write(release_path, JSON.pretty_generate(release) + "\n")
puts JSON.pretty_generate(
       "marketplace_root" => output,
       "release_manifest" => release_path,
       "plugin_id" => release.dig("plugin", "id"),
       "version" => version,
       "forum_url" => forum_url,
       "source_url" => source_url,
       "tree_sha256" => release.dig("plugin", "tree_sha256"),
       "source_tree_sha256" => release.dig("source_snapshot", "tree_sha256"),
       "remote_ref_verified" => false,
     )
